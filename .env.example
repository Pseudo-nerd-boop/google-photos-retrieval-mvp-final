# Environment Configuration Example for Google Photos Retrieval Recovery MVP
# Copy this file to .env.local for local testing with real API credentials.
# Do NOT commit real API keys to git or public repositories.

# Gemini API Key (Server-side only)
GEMINI_API_KEY=your_gemini_api_key_here

# Supported Gemini Flash-class model (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
